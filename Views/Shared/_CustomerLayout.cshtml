<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - MyStore</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    @{
        var username = Session["Username"] as string;
    }

    <!-- CUSTOMER HEADER -->
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink(
                     "MyStore",
                     "Index",
                     "Home",
                     new { area = "" },
                     new { @class = "navbar-brand" }
                 )

            <div class="navbar-collapse d-sm-inline-flex justify-content-between">

                <ul class="navbar-nav">
                    <li class="nav-item">
                        @Html.ActionLink(
                                      "Trang chủ",
                                      "Index",
                                      "Home",
                                      new { area = "" },
                                      new { @class = "nav-link" }
                                  )
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Home")#product-list">
                            Sản phẩm
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#"
                           id="categoryDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Danh mục
                        </a>

                        <ul class="dropdown-menu"
                            aria-labelledby="categoryDropdown">
                            @Html.Action("CategoryMenu", "Home")
                        </ul>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">

                    @if (string.IsNullOrEmpty(username))
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng nhập",
                                     "Login",
                                     "Account",
                                     new { area = "" },
                                     new { @class = "nav-link" }
                                 )
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng ký",
                                     "Register",
                                     "Account",
                                     new { area = "" },
                                     new { @class = "nav-link" }
                                 )
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Tài khoản",
                                     "ProfileInfo",
                                     "Account",
                                     new { area = "" },
                                     new { @class = "nav-link" }
                                 )
                        </li>

                        <li class="nav-item">
                            <span class="nav-link text-white">
                                Xin chào, @username
                            </span>
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng xuất",
                                     "Logout",
                                     "Account",
                                     new { area = "" },
                                     new { @class = "nav-link" }
                                 )
                        </li>

                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- CUSTOMER CONTENT -->
    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>&copy; @DateTime.Now.Year - MyStore</p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>