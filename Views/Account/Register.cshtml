
@model BE4.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<h2>Đăng ký tài khoản</h2>

<hr />

@using (Html.BeginForm("Register", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.Username,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.TextBoxFor(m => m.Username,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.Username,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.PasswordFor(m => m.Password,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.Password,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ConfirmPassword,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.PasswordFor(m => m.ConfirmPassword,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.ConfirmPassword,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerName,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.TextBoxFor(m => m.CustomerName,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.CustomerName,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerPhone,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.TextBoxFor(m => m.CustomerPhone,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.CustomerPhone,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerEmail,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.TextBoxFor(m => m.CustomerEmail,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.CustomerEmail,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CustomerAddress,
                new { @class = "control-label col-md-2" })

            <div class="col-md-5">
                @Html.TextBoxFor(m => m.CustomerAddress,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.CustomerAddress,
                    "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-5">
                <input type="submit" value="Đăng ký"
                       class="btn btn-primary" />
            </div>
        </div>

    </div>
}
