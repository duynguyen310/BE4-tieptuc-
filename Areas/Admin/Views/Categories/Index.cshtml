@model IEnumerable<BE4.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
}

<h2>QUẢN LÝ DANH MỤC</h2>

<p>
    @Html.ActionLink("Thêm danh mục mới", "Create",
        new { area = "Admin" },
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <tr>
        <th>Tên danh mục</th>
        <th>Chức năng</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Sửa", "Edit",
                    new { area = "Admin", id = item.CategoryID },
                    new { @class = "btn btn-warning btn-sm" })

                @Html.ActionLink("Chi tiết", "Details",
                    new { area = "Admin", id = item.CategoryID },
                    new { @class = "btn btn-info btn-sm" })

                @Html.ActionLink("Xóa", "Delete",
                    new { area = "Admin", id = item.CategoryID },
                    new { @class = "btn btn-danger btn-sm" })
            </td>
        </tr>
    }
</table>